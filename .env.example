# ===========================================================================
# Ultimate Waifu Bot — full configuration reference. Copy to `.env` and
# fill in. For a fast deploy see deploy.env.example instead (10 lines).
#
# Everything except BOT_TOKEN has a safe default: the default database is
# ONE FILE (data/waifu.db, no server to run) and Redis is optional, so a
# fresh checkout starts with a single variable and never needs another
# service just to boot.
# ===========================================================================

# --- Telegram -----------------------------------------------------------------
# From @BotFather. Format: <numeric id>:<35 chars>
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Numeric Telegram user id of the bot owner (grants the `owner` role).
OWNER_ID=000000000
# Extra users with the `admin` role (comma separated).
ADMIN_IDS=

# --- Polling vs webhook --------------------------------------------------------
# polling | webhook
MODE=polling
# Required for webhook mode. Generate: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_URL=https://example.com/webhook
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8081
# Path of the certificate when using a self-signed cert with a local server.
WEBHOOK_CERTIFICATE=
# Never throw away queued updates on restart (Summon-bot did: drop_pending_updates=True)
DROP_PENDING_UPDATES=false

# --- Local Bot API server (optional, big uploads + lower latency) -------------
# docker run -d -p 8082:80 ghcr.io/aiogram/bot-api-server:latest
# then: API_URL=http://apiserver:80/bot  API_BASE=http://apiserver:80/file
API_URL=
API_BASE=

# --- Database (ONE — a file by default, Postgres when scaling) ---------------
# The default is a single SQLite file: no server to run, the fastest startup,
# and one file is all there is to back up (`waifu backup`, the daily jobs
# pass, or /backup from Telegram).
#   default (one file):        sqlite+aiosqlite:///data/waifu.db
#   persistent disk (Render):  sqlite+aiosqlite:////opt/render/project/data/waifu.db
#   multi-worker scale-up:     postgresql+asyncpg://user:pass@host:5432/waifu
DATABASE_URL=sqlite+aiosqlite:///data/waifu.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Only used by scripts/migrate_from_summon.py (legacy Summon-bot SQLite file).
LEGACY_DB_PATH=

# --- Redis (optional) ---------------------------------------------------------
# Shared FSM storage, distributed rate limits, hot leaderboards. Leave empty
# to run on in-process state (single worker; the database remains the only
# source of truth, so nothing is stored that a backup would not restore).
REDIS_URL=

# --- Backups -------------------------------------------------------------------
# Where `waifu backup`, the daily jobs pass and /backup write their JSON
# snapshots of the whole database; files older than BACKUP_KEEP are pruned
# after each backup. `waifu restore <file>` brings any of them back.
BACKUP_DIR=./backups
BACKUP_KEEP=10

# --- Economy tuning -----------------------------------------------------------
STARTING_BALANCE=5000
DAILY_REWARD=2500
DAILY_JACKPOT_CHANCE=0.05
DAILY_JACKPOT_MAX=15000
SINGLE_PULL_COST=1000
TEN_PULL_COST=9000
DUPE_SHARDS_FACTOR=25
MARKET_FEE_PERCENT=5
AUCTION_FEE_PERCENT=7
TRADE_TAX_PERCENT=3
PULL_COOLDOWN_SECONDS=8
SPAWN_MIN_INTERVAL=1800
SPAWN_MAX_INTERVAL=5400
SPAWN_CLAIM_WINDOW=180

# --- Pity / gacha maths -------------------------------------------------------
HARD_PITY_4=10
HARD_PITY_5=80
HARD_PITY_6=120
SOFT_PITY_5_START=65
RATE_UP_RATIO=0.5

# --- Feature flags ------------------------------------------------------------
FEATURE_AI=true
FEATURE_MARKET=true
FEATURE_AUCTION=true
FEATURE_TRADE=true
FEATURE_GUILD=true
FEATURE_BATTLE=true
FEATURE_QUESTS=true
FEATURE_STREAK=true
FEATURE_ACHIEVEMENTS=true
FEATURE_STARS=true
FEATURE_PAID_MEDIA=true
FEATURE_BOOST_PERKS=true
FEATURE_REACTIONS=true
FEATURE_GAMES=true
FEATURE_INLINE=true
FEATURE_GUEST_MODE=true
FEATURE_BUSINESS_MODE=true
FEATURE_TOPICS=true
FEATURE_CARDS=true
FEATURE_STICKERS=false
FEATURE_AUTOBAN=true
FEATURE_RICH_MESSAGES=true
FEATURE_DRAFT_STREAM=true
FEATURE_EPHEMERAL=true

# --- AI persona backend (OpenAI-compatible; leave key empty to disable) ------
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=400
AI_DAILY_CHAR_BUDGET=6000
AI_MODERATION=true

# --- Telegram Stars / monetisation -------------------------------------------
STAR_SUPPORTS=true
COIN_PACK_JSON=[{"id":"handful","stars":50,"coins":25000},{"id":"satchel","stars":120,"coins":70000,"bonus_shards":40},{"id":"vault","stars":400,"coins":260000,"bonus_shards":180}]
PAID_MEDIA_STAR_PRICE=45
PREMIUM_SUB_STARS=750
PREMIUM_SUB_DAYS=30

# --- Media / rendering --------------------------------------------------------
# Cards are rendered locally with Pillow; no ImgBB/0x0.st upload needed.
CARD_WIDTH=900
MEDIA_BASE_URL=
FONT_PATH=
ALLOWED_MEDIA_HOSTS=api.telegram.org,cdn.telegram.org,files.catbox.moe,i.ibb.co
ENABLE_OUTBOUND_MEDIA=true

# --- Roster ingestion (the character database) --------------------------------
# A fresh install has NO characters: the owner adds them from Telegram with
#   /upload Name Series 1-18        (reply to a photo/video/GIF/live photo)
#   /autoadd on                     (this group/channel ingests admin media, no command)
# The table below is deliberately empty on purpose — it is content, not config. Set
# SEED_CATALOGUE=1 only if you want the optional 177-entry reference catalogue loaded
# by `waifu migrate`/`waifu seed` (equivalent to `waifu seed --catalogue`, or
# `/reseed` from inside the bot, or `waifu import-legacy ./summon.db` for real data).
SEED_CATALOGUE=0
# Where an upload is copied while the admin decides whether to also want a public URL.
UPLOAD_DIR=./data/uploads
# ImgBB needs a key (free tier is enough); Catbox is anonymous so it is always offered.
IMGBB_API_KEY=
# Mirror every ingested character (media + caption) into LOG_CHANNEL_ID, as the reference
# deployment did with its DB channel. The row is written first, so turning this off — or
# kicking the bot — never loses a character.
UPLOAD_TO_LOG_CHANNEL=1
# The owner's event channel — set this to the id of a channel the bot is an admin of
# (forward one of its messages to @userinfobot). Leave empty to disable. Every line the
# owner should know lands here: bot start/stop/crash, gifts (character + coins), every
# payment (Stars packs, paid media, subscriptions, renewals, refunds), trades, auctions,
# raffle wins, boosts, premium grants, new players, group joins, moderation.
LOG_CHANNEL_ID=

# --- Branding / links ---------------------------------------------------------
BOT_USERNAME=UltimateWaifuBot
SUPPORT_URL=https://t.me/ultimatewaifuchat
CHANNEL_URL=https://t.me/ultimatewaifubot
GROUP_URL=https://t.me/ultimatewaifugame

# --- Mini App + JSON API ------------------------------------------------------
# The page /webapp opens. It is also the ONLY origin the API answers CORS for, so a
# leaked link cannot read a harem from a hostile page.
WEBAPP_URL=
# Front-ends that are not Telegram Mini Apps (an operator dashboard, a monitoring probe)
# authenticate with X-API-Token against this value. Leave empty and only signed initData
# works, which is the correct setting for anything public.
WEBAPP_SECRET_KEY=
# The reference bot's Flask `api.py`, ported: GET /api/health|user/<id>|inventory/<id>|
# characters|market|leaderboard|streak/<id>|achievements/<id>, POST /api/daily/<id> and
# /api/summon/<id>. Off by default — start it with `python -m waifu api` or turn it on
# inside the bot process here.
API_ENABLED=0
API_HOST=0.0.0.0
API_PORT=8080
# ?uid= with no signature: development only. The reference accepted it always, which is
# how its /api/summon became "spend somebody else's coins".
API_ALLOW_UID_QUERY=0
# Seconds a signed initData stays usable, so a captured string expires. 0 = no limit.
API_INIT_DATA_MAX_AGE=86400

# --- Keep-alive health server (free-tier platforms: Render/Koyeb/Railway) -----
# A tiny HTTP server so a free *web* service never sleeps for idleness and uptime
# monitors have something to ping (the Videl pattern). In polling mode it answers
#   GET /  and  GET /health   -> {"status":"healthy","bot":...,"version":...,"uptime_seconds":N}
#   GET /healthz              -> deeper check (database + redis), 503 when unhealthy
# on $PORT (the platform sets PORT itself; set HEALTH_PORT to override, 0 = auto).
# Webhook mode already serves /healthz, so this is skipped there. A taken port logs a
# warning and the bot continues without it.
HEALTH_ENABLED=1
HEALTH_PORT=0
HEALTH_HOST=0.0.0.0


# --- i18n ---------------------------------------------------------------------
DEFAULT_LOCALE=en
# Server timezone used for daily/weekly rollovers (very visible to players)
TIMEZONE=Asia/Kolkata

# Card delivery: auto | rich | plain | off (auto probes the API server once at startup)
CHAT_MODE=auto
DATA_DIR=./data

# --- Startup behaviour --------------------------------------------------------
# Publish the ⊞ command menu at boot, generated from the wired routers (never a
# hand-kept list, so it cannot go stale). Disable if you manage it in BotFather.
SET_COMMAND_MENU=true
# Run the timer loop in-process (spawn feed, auction settlement, expiries, raffles).
# Set to false when cron drives it instead: `waifu jobs --name autospawn`.
NO_JOBS=false
# Migrate a Summon-bot database on first boot (path or postgres:// URL of the old bot).
# Then run: python -m waifu import-legacy "$LEGACY_DB_PATH"
LEGACY_DB_PATH=
