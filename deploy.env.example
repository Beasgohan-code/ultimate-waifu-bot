# =====================================================================
#  ULTIMATE WAIUFU BOT — deploy environment
#
#  Copy this file to `.env`, set BOT_TOKEN, done. That is the whole setup:
#  the default database is ONE FILE (data/waifu.db) and Redis is optional,
#  so there is no server to install and nothing to connect to.
#  The full, commented reference stays in .env.example.
# =====================================================================

# ---------------------------------------------------------------------
#  REQUIRED — the only variable the bot cannot start without
# ---------------------------------------------------------------------
# From @BotFather (format: <digits>:<secret>)
BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE

# ---------------------------------------------------------------------
#  RECOMMENDED — owner commands + the event feed
# ---------------------------------------------------------------------
# Your numeric Telegram id (forward any message to @userinfobot to read it).
# Owner-only commands (/backup, /doctor, /setlogchannel, /broadcast, …) need this.
OWNER_ID=0
# A channel the bot is an ADMIN of: every gift, payment, join and crash
# lands there. Leave 0 to skip.
LOG_CHANNEL_ID=0

# ---------------------------------------------------------------------
#  OPTIONAL — every line below already has a working default
# ---------------------------------------------------------------------
# The database: ONE FILE by default (fastest startup, nothing to install).
#   local / self-hosted → leave the default (sqlite+aiosqlite:///data/waifu.db)
#   Render persistent disk → IMPORTANT: the project dir is wiped on every
#   deploy, so point the file at the mounted disk or you WILL lose the data:
#     DATABASE_URL=sqlite+aiosqlite:////opt/render/project/data/waifu.db
#   several workers → Postgres (docker-compose.yml is the full stack):
#     DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/waifu
#
# Shared FSM storage + rate limits (optional; single-worker runs are fine
# without it — nothing is stored that the database does not also hold):
#   REDIS_URL=redis://localhost:6379/0
#
# Extra admins (comma separated):            ADMIN_IDS=123,456
# Keep this many daily backups (10 = 10 days): BACKUP_KEEP=10
# Backups go here:                           BACKUP_DIR=./backups
# Webhooks instead of polling:               MODE=webhook  (+ WEBHOOK_SECRET, WEBHOOK_URL)
# AI persona backend:                        AI_API_KEY=sk-…
