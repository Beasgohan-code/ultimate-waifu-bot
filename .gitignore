# --- secrets & local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- runtime state that must never be tracked (Summon-bot committed all of these) ---
*.log
logs/
*.session
*.session-journal
*.db
*.db-shm
*.db-wal
data/
# …but the catalogue that ships *inside the package* is source, not runtime state:
# waifu/data/characters.seed.json is the 177-character roster and the 18-tier ladder, so
# ignoring it would make a fresh clone boot with an empty bot.
!waifu/data/
!waifu/data/**
# throwaway investigation scripts (signature dumps, one-off audits)
.scratch/
media/
tmp/
cache/
backups/
*.bak

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / os ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
