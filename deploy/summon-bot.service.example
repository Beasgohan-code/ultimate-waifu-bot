# systemd unit for this bot — the reference deployment shipped `summon-bot.service.example`
# and ran a supervisor inside it, which is what `deploy/supervisor.py` is for. Copy to
# /etc/systemd/system/ultimate-waifu-bot.service, adjust the paths, then:
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now ultimate-waifu-bot
#
# Secrets live in EnvironmentFile, never in this unit (systemd logs show unit contents).
[Unit]
Description=Ultimate Waifu Bot (aiogram 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ultimate-waifu-bot
EnvironmentFile=/opt/ultimate-waifu-bot/.env
# The supervisor keeps the bot alive and can recycle it on a timer
# (AUTO_RESTART_MINUTES). Drop this line for `ExecStart=/usr/bin/python3 -m waifu bot`
# and let systemd do the restarting — one layer is enough.
ExecStart=/usr/bin/python3 deploy/supervisor.py
Restart=always
RestartSec=10
# The supervisor gives the child 30s to answer SIGTERM; leave it room to log and close.
TimeoutStopSec=45
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ultimate-waifu-bot/data

[Install]
WantedBy=multi-user.target
